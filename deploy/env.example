# Production environment variables required/read by backend/config/settings/prod.py
# (and base.py). Copy to your secret store (AWS Secrets Manager / SSM); never commit values.
# prod.py does NOT load a .env file. DATABASE_URL, DJANGO_DB_ENGINE and
# DJANGO_CSRF_TRUSTED_ORIGINS are explicitly rejected if set.

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=            # >=50 chars, not "django-insecure-..."
DJANGO_ALLOWED_HOSTS=         # comma list, e.g. app.example.com

DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=               # RDS endpoint hostname
DJANGO_DB_PORT=5432

# Three DISTINCT Fernet keys (32 random bytes, urlsafe base64). Generate each with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GMAIL_TOKEN_ENCRYPTION_KEY=
MICROSOFT_TOKEN_ENCRYPTION_KEY=
IMAP_TOKEN_ENCRYPTION_KEY=

# S3 document storage (leave keys empty to use the ECS/EC2 IAM role)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Celery / Redis (ElastiCache)
CELERY_BROKER_URL=redis://HOST:6379/0
# CELERY_RESULT_BACKEND defaults to CELERY_BROKER_URL

# Provider OAuth (only for providers you enable)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=
