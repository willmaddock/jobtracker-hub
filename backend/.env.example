# Local development settings. Copy to backend/.env (git-ignored). dev.py loads it.
# Create-an-account-and-log-in with MFA, no external services needed:
EMAIL_SIGNIN_ENABLED=true
EMAIL_SIGNUP_OPEN=true
MFA_EMAIL_FROM=no-reply@localhost.test
MFA_REQUIRED=true
# false = a new account must also enrol an authenticator app (recommended).
EMAIL_SIGNIN_SATISFIES_MFA=false
# Passkeys already default to http://localhost:8000 in dev; browse via localhost (not 127.0.0.1).

# --- Gateway: sign in with Django, then use the original JobTracker app (your own private copy) ---
JTH_GATEWAY=true
# Where each user's private trackers and databases are stored (default: jth-data/ in the repo root).
# JTH_DATA_DIR=/path/to/data
# Local single-user convenience: lets superusers link an existing folder on this computer in place.
JTH_ALLOW_LOCAL_LINK=true
